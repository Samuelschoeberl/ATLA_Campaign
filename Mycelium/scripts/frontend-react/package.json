{
  "name": "mycelium-frontend-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-env": "./check-env.sh",
    "test": "PATH=/usr/local/bin:$PATH playwright test",
    "test:headed": "PATH=/usr/local/bin:$PATH playwright test --headed",
    "test:ui": "PATH=/usr/local/bin:$PATH playwright test --ui",
    "test:debug": "PATH=/usr/local/bin:$PATH playwright test --debug",
    "test:report": "PATH=/usr/local/bin:$PATH playwright show-report",
    "test:codegen": "PATH=/usr/local/bin:$PATH playwright codegen http://localhost:5173",
    "test:analyze": "./test-with-analysis.sh",
    "test:analyze:headed": "./test-with-analysis.sh --headed",
    "test:extract": "node extract-test-results.js",
    "test:extract:failed": "node extract-test-results.js --failed-only",
    "test:stability": "PATH=/usr/local/bin:$PATH playwright test tests/e2e/stability-10-clients.spec.js tests/e2e/race-conditions.spec.js --workers=1",
    "test:stability:headed": "PATH=/usr/local/bin:$PATH playwright test tests/e2e/stability-10-clients.spec.js tests/e2e/race-conditions.spec.js --workers=1 --headed",
    "test:stability:ui": "PATH=/usr/local/bin:$PATH playwright test tests/e2e/stability-10-clients.spec.js tests/e2e/race-conditions.spec.js --ui",
    "test:10-clients": "PATH=/usr/local/bin:$PATH playwright test tests/e2e/stability-10-clients.spec.js --workers=1",
    "test:race": "PATH=/usr/local/bin:$PATH playwright test tests/e2e/race-conditions.spec.js --workers=1",
    "test:sync": "PATH=/usr/local/bin:$PATH playwright test tests/e2e/sync-basic.spec.js tests/e2e/scalability-sync.spec.js tests/e2e/speed-multiclient.spec.js --workers=1",
    "test:all-multi": "PATH=/usr/local/bin:$PATH playwright test tests/e2e/stability-10-clients.spec.js tests/e2e/race-conditions.spec.js tests/e2e/sync-basic.spec.js tests/e2e/scalability-sync.spec.js tests/e2e/speed-multiclient.spec.js --workers=1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "animejs": "^4.3.4",
    "dompurify": "^3.0.6",
    "flask": "^0.2.10",
    "marked": "^9.1.6",
    "plotly.js": "^3.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-plotly.js": "^2.6.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
